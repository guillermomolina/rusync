    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'rusync'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=rusync",
                    "--package=rusync"
                ],
                "filter": {
                    "name": "rusync",
                    "kind": "bin"
                }
            },
            "args": [
                //"-n",
                // "--progress",
                "--parallelism=1",
                "--log-level=debug",
                // "/home/gmolina/Temporal",
                // "/home/gmolina/Temporal2"
                "/home/guille/Red/Temporal/a",
                "/home/guille/Red/Temporal/b"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in library 'rusync'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=rusync"
                ],
                "filter": {
                    "name": "rusync",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
